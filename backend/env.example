# ============================================
# Sentinel CTI Backend - Environment Configuration
# ============================================
# Copy this file to .env in the backend directory
# cp env.example .env

NODE_ENV=development
PORT=3001

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database
DATABASE_URL=postgresql://sentinel:sentinel_dev@localhost:5432/sentinel_db

# Redis
REDIS_URL=redis://:redis_dev@localhost:6379

# JWT Authentication
# Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
